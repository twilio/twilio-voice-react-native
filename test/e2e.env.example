# Local e2e environment. Copy to test/e2e.env, fill in, and source before
# running the harness. test/e2e.env is gitignored; never commit real values.
#
# Every value comes from the Twilio Console for the account under test.

export ACCOUNT_SID=
export AUTH_TOKEN=
export API_KEY_SID=
export API_KEY_SECRET=
export CLIENT_IDENTITY=

# TwiML applications. Must point at a live voiceUrl or outgoing calls never answer.
export OUTGOING_APPLICATION_SID=
export PREFLIGHT_OUTGOING_APPLICATION_SID=

# Only needed for incoming-call suites, which require a push credential
# registered with Twilio and a matching google-services.json in the app.
export PUSH_CREDENTIAL_SID=
