# Local e2e environment. Copy to test/e2e.env, fill in, and source before running
# the harness. test/e2e.env is gitignored; never commit real values.
#
# Credentials live in the twilio-voicejs-app repo. See test/MASTER_TEST_PLAN.md
# section 5 for the mapping between that repo's .env names and these.

export ACCOUNT_SID=
export AUTH_TOKEN=
export API_KEY_SID=                        # twilio-voicejs-app .env calls this API_KEY
export API_KEY_SECRET=                     # twilio-voicejs-app .env calls this API_SECRET
export CLIENT_IDENTITY=

# TwiML applications. Must point at a live voiceUrl or outgoing calls never answer.
export OUTGOING_APPLICATION_SID=
export PREFLIGHT_OUTGOING_APPLICATION_SID=

# Only needed for incoming-call suites, which are Blocked until a real Firebase
# project exists. See test/MASTER_TEST_PLAN.md section 9.1.
export PUSH_CREDENTIAL_SID=
